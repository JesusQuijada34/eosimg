{
  "schema": "eos-themes-0.1",
  "default": "etternhall-dark",
  "themes": {
    "etternhall-dark": {
      "surface": "#0f1420",
      "surface-elevated": "#172239",
      "surface-accent": "#223252",
      "text": "#eef3ff",
      "text-secondary": "#9fb0d0",
      "accent": "#4778c9",
      "focus": "#a8c7ff",
      "radius": 10,
      "touch-target-min": 44
    },
    "etternhall-light": {
      "surface": "#f5f7fb",
      "surface-elevated": "#ffffff",
      "surface-accent": "#e7eefb",
      "text": "#172239",
      "text-secondary": "#4a5a75",
      "accent": "#2d62b5",
      "focus": "#174b9c",
      "radius": 10,
      "touch-target-min": 44
    },
    "etternhall-contrast": {
      "surface": "#000000",
      "surface-elevated": "#111111",
      "surface-accent": "#252525",
      "text": "#ffffff",
      "text-secondary": "#ffffff",
      "accent": "#66ccff",
      "focus": "#ffff00",
      "radius": 4,
      "touch-target-min": 48
    }
  },
  "accessibility": {
    "focus-visible": true,
    "keyboard-navigation": true,
    "reduced-motion": true,
    "minimum-text-scale": 1.0,
    "screen-reader-labels": "required-for-controls"
  }
}
