{
  "schema": "eos-services-0.1",
  "boot_target": "eos-phone-shell",
  "services": [
    {"name": "eos-logd", "layer": "core", "dependencies": [], "network": "none"},
    {"name": "eos-netd", "layer": "core", "dependencies": ["eos-logd", "eos-policyd"], "network": "brokered"},
    {"name": "eos-policyd", "layer": "security", "dependencies": ["eos-logd"], "network": "none"},
    {"name": "eos-powerd", "layer": "device", "dependencies": ["eos-logd"], "network": "none"},
    {"name": "eos-deviced", "layer": "device", "dependencies": ["eos-logd", "eos-policyd"], "network": "none"},
    {"name": "eos-storaged", "layer": "storage", "dependencies": ["eos-logd", "eos-policyd"], "network": "none"},
    {"name": "eos-packaged", "layer": "runtime", "dependencies": ["eos-logd", "eos-storaged", "eos-policyd"], "network": "none"},
    {"name": "eos-modeld", "layer": "ai", "dependencies": ["eos-logd", "eos-storaged", "eos-policyd"], "network": "consent-only"},
    {"name": "eos-audiod", "layer": "ai", "dependencies": ["eos-deviced", "eos-policyd"], "network": "none"},
    {"name": "eos-assistantd", "layer": "ai", "dependencies": ["eos-modeld", "eos-audiod", "eos-policyd"], "network": "none"},
    {"name": "eos-inputd", "layer": "device", "dependencies": ["eos-logd", "eos-policyd"], "network": "none"},
    {"name": "eos-displayd", "layer": "ui", "dependencies": ["eos-logd", "eos-powerd", "eos-policyd"], "network": "none"},
    {"name": "eos-windowd", "layer": "ui", "dependencies": ["eos-displayd", "eos-policyd"], "network": "none"},
    {"name": "eos-immersived", "layer": "ui", "dependencies": ["eos-windowd", "eos-inputd"], "network": "none"},
    {"name": "eos-blinked", "layer": "ui", "dependencies": ["eos-windowd", "eos-policyd"], "network": "none"},
    {"name": "eos-browserd", "layer": "app", "dependencies": ["eos-windowd", "eos-storaged", "eos-netd", "eos-policyd"], "network": "consent-only"},
    {"name": "eos-mediad", "layer": "app", "dependencies": ["eos-storaged", "eos-netd", "eos-policyd"], "network": "consent-only"},
    {"name": "eos-photod", "layer": "app", "dependencies": ["eos-mediad", "eos-windowd", "eos-policyd"], "network": "none"},
    {"name": "eos-launcherd", "layer": "app", "dependencies": ["eos-packaged", "eos-windowd", "eos-policyd"], "network": "none"},
    {"name": "eos-marketd", "layer": "app", "dependencies": ["eos-packaged", "eos-launcherd", "eos-policyd"], "network": "none"},
    {"name": "eos-phone-shell", "layer": "shell", "dependencies": ["eos-windowd", "eos-packaged", "eos-inputd", "eos-immersived", "eos-blinked"], "network": "none"}
  ]
}
